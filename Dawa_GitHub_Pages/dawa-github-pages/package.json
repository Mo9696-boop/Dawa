{
  "name": "dawa-github-pages",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/check-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.edge.json",
    "test": "node --test tests/*.test.mjs",
    "setup-key": "node scripts/setup-key.mjs"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
